{
	servers {
		trusted_proxies static private_ranges 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

{$DOMAIN:localhost} {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	@static path /_next/static/* /_next/image*
	header @static Cache-Control "public, max-age=31536000, immutable"
	header @static CDN-Cache-Control "public, max-age=31536000, immutable"

	# Health probes (mounted at /health and /api/v1/health)
	handle /health/* {
		reverse_proxy api:8000
	}

	# Same-origin API: set PUBLIC_API_URL=https://{$DOMAIN}/api/v1
	handle /api/* {
		reverse_proxy api:8000
	}

	# Root-mounted API paths used by OAuth callbacks and Stripe webhooks
	handle /integrations/* {
		reverse_proxy api:8000
	}
	handle /billing/* {
		reverse_proxy api:8000
	}
	handle /auth/* {
		reverse_proxy api:8000
	}

	handle_path /docs* {
		reverse_proxy api:8000
	}
	handle_path /openapi.json {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy frontend:3000
	}
}
