# Copy to .env before running compose.production.yml. Never commit .env.
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
CORS_ORIGINS=https://app.example.com
# Must match Caddy same-origin proxy: /api/* → api:8000 (API also mounts /api/v1)
PUBLIC_API_URL=https://app.example.com/api/v1
PUBLIC_DOMAIN=app.example.com
PUBLIC_APP_URL=https://app.example.com

SCRAPE_INTERVAL_MINUTES=15
SCRAPE_SOURCES=serpapi_freelance,serpapi_jobs,serpapi_companies

# LLM fallback: groq > nvidia > gemini > openai > anthropic
GROQ_API_KEY=
NVIDIA_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SERPAPI_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=signaldesk:discovery:v1 (by /u/yourreddituser)
REDDIT_SUBREDDITS=forhire,hiring

UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
UPWORK_REDIRECT_URI=https://app.example.com/api/v1/integrations/upwork/callback
UPWORK_ACCESS_TOKEN=
UPWORK_REFRESH_TOKEN=
FREELANCER_OAUTH_TOKEN=
APIFY_TOKEN=

SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_TWILIO_SID=
WHATSAPP_TWILIO_TOKEN=
WHATSAPP_TWILIO_FROM=
WHATSAPP_TO=

# Required in production for verify/reset/alert emails
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# If STRIPE_SECRET_KEY + STRIPE_PRICE_PRO are set, STRIPE_WEBHOOK_SECRET is required
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_SUCCESS_URL=https://app.example.com/preferences?billing=success
STRIPE_CANCEL_URL=https://app.example.com/pricing?billing=cancel

# Optional. When set, the API loads these keys from AWS Secrets Manager
# and boto3 must be installed (it is listed in fastapi/requirements.txt).
SENTRY_DSN=
AWS_SECRETS_MANAGER_ARN=
AWS_REGION=us-east-1
S3_BUCKET=
REDIS_URL=redis://redis:6379/0

# Edge. Leave the token empty until a Cloudflare Tunnel exists.
# Then: CADDY_BIND=127.0.0.1 and
#   docker compose -f compose.production.yml --profile cloudflare up -d
# Orange-cloud DNS in front of a public Caddy also works; Caddy trusts Cloudflare ranges.
CLOUDFLARE_TUNNEL_TOKEN=
CADDY_BIND=0.0.0.0
UPTIME_URL=https://app.example.com
