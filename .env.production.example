# =============================================================================
# Locked production: one GCP VM (API + worker + beat + Postgres + Redis + Caddy)
# + Vercel frontend only. See docs/deploy.md
#
#   copy .env.production.example .env
#   docker compose -f compose.production.yml up -d --build
#
# Never commit a real .env.
# =============================================================================

APP_ENV=production
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET_KEY=replace-with-at-least-32-random-characters

# API hostname on the VM (DNS A/AAAA → VM). Caddy issues TLS for this domain.
PUBLIC_DOMAIN=api.yourdomain.com
# Used by Vercel: NEXT_PUBLIC_API_URL must match this
PUBLIC_API_URL=https://api.yourdomain.com/api/v1
# Vercel frontend origin (no trailing slash)
PUBLIC_APP_URL=https://your-app.vercel.app
CORS_ORIGINS=https://your-app.vercel.app
UPTIME_URL=https://api.yourdomain.com/api/v1/health/live

# Compose wires local DB/Redis (do not set Supabase/Upstash for this locked path):
# DATABASE_URL=postgresql+asyncpg://freelance:…@db:5432/freelance
# REDIS_URL=redis://redis:6379/0

# Optional: bind Caddy to localhost when using Cloudflare Tunnel
# CADDY_BIND=127.0.0.1
# CLOUDFLARE_TUNNEL_TOKEN=
# Optional bundled UI on the VM (not locked): CADDYFILE=./Caddyfile and --profile frontend

SCRAPE_INTERVAL_MINUTES=15
SCRAPE_SOURCES=serpapi_freelance,serpapi_jobs,serpapi_companies

GROQ_API_KEY=
NVIDIA_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SERPAPI_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=signaldesk:discovery:v1 (by /u/yourreddituser)
REDDIT_SUBREDDITS=forhire,hiring

UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
UPWORK_REDIRECT_URI=https://api.yourdomain.com/api/v1/integrations/upwork/callback
UPWORK_ACCESS_TOKEN=
UPWORK_REFRESH_TOKEN=
FREELANCER_OAUTH_TOKEN=
APIFY_TOKEN=

SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_TWILIO_SID=
WHATSAPP_TWILIO_TOKEN=
WHATSAPP_TWILIO_FROM=
WHATSAPP_TO=

EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# Webhook: https://api.yourdomain.com/api/v1/billing/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_SUCCESS_URL=https://your-app.vercel.app/preferences?billing=success
STRIPE_CANCEL_URL=https://your-app.vercel.app/pricing?billing=cancel

SENTRY_DSN=
S3_BACKUP_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_SECRETS_MANAGER_ARN=
AWS_REGION=us-east-1
S3_BUCKET=
