APP_ENV=development
# Local-only: auto-verify without SMTP, /auth/dev-verify, and verify_url in responses.
# Must stay false/unset in production.
DEBUG=true
PROJECT_NAME=Freelance Intelligence API
VERSION=0.5.0
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/freelance
# Production (Supabase pooler): postgresql+asyncpg://...@....pooler.supabase.com:6543/postgres?ssl=require
REDIS_URL=redis://localhost:6379/0
# Production (Upstash): rediss://default:...@....upstash.io:6379
REDIS_OPTIONAL=true
JWT_SECRET_KEY=dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SCRAPE_ON_STARTUP=false
SCRAPE_INTERVAL_MINUTES=0
SCRAPE_LIMIT=30
SCRAPE_NOTIFY_MATCHES=true
SCRAPE_SOURCES=serpapi_freelance,serpapi_jobs,serpapi_companies

# LLM providers — fallback order: groq > nvidia > gemini > openai > anthropic
# Only configured keys are tried; missing keys are skipped.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Upwork (official GraphQL API — register at https://www.upwork.com/developer/)
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
UPWORK_REDIRECT_URI=http://127.0.0.1:8000/integrations/upwork/callback
UPWORK_ACCESS_TOKEN=
UPWORK_REFRESH_TOKEN=
UPWORK_SEARCH_QUERY=python OR fastapi OR react

# Freelancer.com (official API token from developer portal)
FREELANCER_OAUTH_TOKEN=
FREELANCER_SEARCH_QUERY=python

# Community connectors for marketplaces without supported public job-search APIs.
# These call the named Apify actors; review actor pricing and terms before enabling.
APIFY_TOKEN=
PEOPLEPERHOUR_ACTOR_ID=crawlerbros/peopleperhour-scraper
PEOPLEPERHOUR_SEARCH_QUERY=python
GURU_ACTOR_ID=shahidirfan/guru-com-scraper
GURU_SEARCH_QUERY=python

# SerpAPI discovery (Pro) — https://serpapi.com/
# serpapi_freelance uses Google organic; serpapi_jobs uses Google Jobs.
SERPAPI_API_KEY=
# W5 optional: Reddit [Hiring] hunter (not in V1 default schedule)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=signaldesk:discovery:v1 (by /u/yourreddituser)
REDDIT_SUBREDDITS=forhire,hiring
SERPAPI_FREELANCE_QUERY=("looking for" OR hiring OR need) (freelancer OR contractor) (python OR fastapi OR react) -course -tutorial
SERPAPI_JOBS_QUERY=python OR fastapi OR react remote developer
# Keyword prefix for company discovery. site: batches use SERPAPI_COMPANY_SITES or the built-in allowlist.
SERPAPI_COMPANIES_QUERY=(careers OR "we're hiring" OR "open roles" OR jobs) (python OR fastapi OR react)
# Optional override (comma-separated hosts). Empty = built-in company allowlist.
SERPAPI_COMPANY_SITES=
SERPAPI_MAPS_QUERY=software agencies OR startups hiring developers
SERPAPI_MAPS_LL=
SERPAPI_LOCATION=
SERPAPI_GL=us
SERPAPI_HL=en

# Alert providers. Unconfigured channels report provider_not_configured.
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_TWILIO_SID=
WHATSAPP_TWILIO_TOKEN=
WHATSAPP_TWILIO_FROM=
WHATSAPP_TO=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# Stripe (optional until you take payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_SUCCESS_URL=http://localhost:3000/preferences?billing=success
STRIPE_CANCEL_URL=http://localhost:3000/pricing?billing=cancel
PUBLIC_APP_URL=http://localhost:3000
