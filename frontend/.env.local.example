# Local API
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# Production (Vercel): VM API domain including /api/v1
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1

# Show “Verify for local dev” on Hunt Rules (requires API DEBUG=true).
NEXT_PUBLIC_ALLOW_DEV_VERIFY=true

# Set only to the verified public site domain; leave unset until configured.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=your-domain.example
